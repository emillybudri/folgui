<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dia"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/widget_toque"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/widget_dia_semana"
        style="@style/WidgetTexto.Suave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp" />

    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/widget_dia_numero"
            style="@style/WidgetTexto.Titulo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/widget_dia_anel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_anel_hoje"
            android:visibility="gone" />
    </FrameLayout>

    <ImageView
        android:id="@+id/widget_dia_ponto"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginTop="3dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_ponto"
        android:visibility="invisible" />
</LinearLayout>
